# Copy to .env on the server only. Never commit real credentials.
HOST=127.0.0.1
PORT=8767
PUBLIC_ORIGIN=https://www.automaix.co.jp
COOKIE_SECURE=true
# Muumuu: control panel > mail address list > info@automaix.co.jp > settings > SMTP server.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@automaix.co.jp
SMTP_PASS=
SMTP_FROM=info@automaix.co.jp
# Enable only behind a trusted loopback reverse proxy that appends the real client IP.
TRUST_LOOPBACK_PROXY=false
